# syntax=docker/dockerfile:1

FROM ghcr.io/astral-sh/uv:0.8.14 AS uv

FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy

WORKDIR /app

COPY --from=uv /uv /uvx /bin/
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project

# Keep the build context deliberately narrow: backend/.env must never enter the
# image, while all Python modules reachable from the worker remain available.
COPY *.py ./
COPY nodes ./nodes
COPY security ./security

CMD ["uv", "run", "--no-sync", "python", "worker_main.py"]
